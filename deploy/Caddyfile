# Production Caddy for tolerance.cc. This file is the source of truth:
# deploy.yml ships it to /opt/tolerance/Caddyfile and reloads Caddy, so edits
# made by hand on the server are overwritten on the next deploy.
{
	servers {
		# Russian visitors come through the relay on Selectel (139.100.217.119, deploy/README.md): it passes TCP
		# here with PROXY protocol v2, so Caddy still terminates TLS and sees the real client. Only the relay may
		# send the header; everyone else connects as usual.
		listener_wrappers {
			proxy_protocol {
				timeout 5s
				allow 139.100.217.119/32
				fallback_policy skip
			}
			tls
		}
		# No HTTP/3: the relay carries TCP only, and a QUIC attempt to it would only delay the page.
		protocols h1 h2

		timeouts {
			read_header 10s
			read_body 30s
			write 60s
			idle 2m
		}
		max_header_size 64KB
	}
}

# tolerance.cc's DNS is Bunny (deploy/README.md): Russia gets the relay's address, everyone else this host's.
# Its certificates, the *.tolerance.cc wildcard for the previews among them, come from Let's Encrypt through
# DNS-01 (caddy-dns/bunny, built into tolerance-caddy; BUNNY_API_KEY in .env).
(acme_dns) {
	tls {
		dns bunny {env.BUNNY_API_KEY}
	}
}

{$ARENA_DOMAIN} {
	import acme_dns

	encode zstd gzip

	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers>Cookie delete
				request>headers>Authorization delete
				resp_headers>Set-Cookie delete
			}
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
		-Server
	}

	handle /api/v1/healthz {
		rewrite * /healthz
		reverse_proxy api:8080
	}

	handle /api/* {
		# The backend enforces per-route caps (20 MiB agent bundles); this
		# only keeps Caddy from being the stricter one.
		request_body {
			max_size 24MB
		}
		reverse_proxy api:8080 {
			header_up X-Real-IP {client_ip}
		}
	}

	handle {
		reverse_proxy web:3000
	}
}

www.{$ARENA_DOMAIN} {
	import acme_dns
	redir https://{$ARENA_DOMAIN}{uri} permanent
}

# Live previews: p-<run>.{$ARENA_DOMAIN} → the gateway, which starts the run's app from its snapshot on demand.
# This is agent-written code, so each preview is its own origin and the api refuses writes from other origins.
# The wildcard record in Bunny DNS points them here (or at the relay); one wildcard certificate covers them all.
# The gateway sets frame-ancestors to the site, so previews open only inside tolerance.cc or on their own.
*.{$ARENA_DOMAIN} {
	import acme_dns
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}
	reverse_proxy gateway:8091
}

# mentor.nualimov.dev (repo artur-gavronchuk/nualimov.dev): its own stack runs
# from /root/nualimov.dev with no public ports; its Caddy joins
# tolerance_default as mentor-web. Nothing else is hosted on this server.
# nualimov.dev's DNS is Bunny too: mentor is a script record on the same
# tolerance-geo script, so Russia reaches it through the relay. Certificate:
# Caddy's default ACME (HTTP-01 / TLS-ALPN-01).
mentor.nualimov.dev {
	reverse_proxy mentor-web:80 {
		header_up X-Forwarded-For {client_ip}
	}
}
