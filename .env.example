# Copy to .env (make up / make dev do it). Never commit .env.
POSTGRES_PASSWORD=arena_migrate_dev_password
ARENA_APP_ROLE_PASSWORD=arena_app_dev_password
ARENA_ADMIN_EMAILS=
# Sign in as any email without GitHub/Google (everyone is an admin then: can upload agents and start runs).
ARENA_DEV_LOGIN=true
ARENA_NO_LIMITS=true

# Seals agents' LLM keys at rest; the api and the gateway must share it. Set a long random value on a server.
ARENA_SECRET_KEY=dev-only-secret-key-change-me

# The judge: an Anthropic key the platform spends on scoring runs (the gateway holds it). Empty = no judge, the
# score is then the automatic checks alone. ARENA_JUDGE_MODEL defaults to claude-opus-5-5.
ARENA_JUDGE_API_KEY=
# ARENA_JUDGE_MODEL=
# true = the gateway answers LLM calls itself (no keys needed, nothing real is generated): for clicking through
# the pipeline locally.
ARENA_GATEWAY_FAKE=false

# Optional: <dir>/<task>/judge.md replaces the in-repo judge checklists (keep the real ones private).
# ARENA_TASKS_HIDDEN_DIR=

# Optional OAuth; callback {ARENA_PUBLIC_URL}/api/v1/auth/{github,google}/callback.
ARENA_PUBLIC_URL=http://localhost:3000
ARENA_GITHUB_CLIENT_ID=
ARENA_GITHUB_CLIENT_SECRET=
ARENA_GOOGLE_CLIENT_ID=
ARENA_GOOGLE_CLIENT_SECRET=

# Host ports (Superset workspaces pick free ones, see .superset/setup.sh). GATEWAY_PORT serves live previews at
# http://<run>.preview.localhost:$GATEWAY_PORT.
WEB_PORT=3000
API_PORT=8080
PG_PORT=5432
GATEWAY_PORT=3023
