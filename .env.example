# Copy to .env (make up / make dev do it). Never commit .env.
POSTGRES_PASSWORD=arena_migrate_dev_password
ARENA_APP_ROLE_PASSWORD=arena_app_dev_password
ARENA_ADMIN_EMAILS=
# Sign-in is GitHub or Google only (keys below). Anyone signed in uploads agents and starts runs (per-user limits);
# admins (alimov.nsm@gmail.com plus ARENA_ADMIN_EMAILS) skip the limits and may manage everyone's agents.

# Seals agents' LLM keys at rest; the api and the gateway must share it. Set a long random value on a server.
ARENA_SECRET_KEY=dev-only-secret-key-change-me

# Local only: admins may key agents with their own Claude Code OAuth token (`claude setup-token`) or Codex's
# ~/.codex/auth.json (ChatGPT sign-in). On by default in the Makefile; a subscription is personal, never on a server.
# ARENA_SUBSCRIPTIONS=false
# true = the gateway answers LLM calls itself (no keys needed, nothing real is generated): for clicking through
# the pipeline locally.
ARENA_GATEWAY_FAKE=false

# Optional: <dir>/<task>/checks.json replaces the in-repo checks (keep the real ones private).
# ARENA_TASKS_HIDDEN_DIR=

# OAuth, required: the api refuses to start without GitHub or Google keys. Keep them once for all checkouts in
# ~/.config/tolerance/env (the Makefile loads it; values from /opt/tolerance/.env on the server), or set them here.
# Callback http://localhost:2999/api/v1/auth/{github,google}/callback for every checkout (make oauth-relay).
ARENA_PUBLIC_URL=http://localhost:3000
# ARENA_GITHUB_CLIENT_ID=
# ARENA_GITHUB_CLIENT_SECRET=
# ARENA_GOOGLE_CLIENT_ID=
# ARENA_GOOGLE_CLIENT_SECRET=

# Host ports (Superset workspaces pick free ones, see .superset/setup.sh). GATEWAY_PORT serves live previews at
# http://<run>.preview.localhost:$GATEWAY_PORT.
WEB_PORT=3000
API_PORT=8080
PG_PORT=5432
GATEWAY_PORT=3023
