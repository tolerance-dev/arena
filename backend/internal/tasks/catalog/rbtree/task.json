    {"name": "delete everything", "method": "POST", "path": "/api/tree/delete", "body": {"keys": [83, 124, 142, 358, 413, 451, 463, 659, 744, 866, 1000, 1001, 2001, 2003, 2005, 2007, 2009, 2011, 2013, 2015, 2017, 2019, 2021, 2023, 2025, 2027, 2029, 2031, 2033, 2035, 2037, 2039, 2041, 2043, 2045, 2047, 2049, 2051, 2053, 2055, 2057, 2059, 2061, 2063, 2065, 2067, 2069, 2071, 2073, 2075, 2077, 2079, 2081, 2083, 2085, 2087, 2089, 2091, 2093, 2095, 2097, 2099, 2101, 2103, 2105, 2107, 2109, 2111, 2113, 2115, 2117, 2119, 2121, 2123, 2125, 2127, 2129, 2131, 2133, 2135, 2137, 2139, 2141, 2143, 2145, 2147, 2149, 2151, 2153, 2155, 2157, 2159, 2161, 2163, 2165, 2167, 2169, 2171, 2173, 2175, 2177, 2179, 2181, 2183, 2185, 2187, 2189, 2191, 2193, 2195, 2197, 2199]}, "status": 200, "expect": [{"path": "deleted", "equals": 112}, {"path": "size", "equals": 0}]},
    {"name": "empty tree has no root", "method": "GET", "path": "/api/tree", "status": 200, "expect": [{"path": "size", "equals": 0}, {"path": "root", "equals": null}]},
    {"name": "first key becomes a black root", "method": "POST", "path": "/api/tree/insert", "body": {"keys": [17]}, "status": 200, "expect": [{"path": "size", "equals": 1}]},
    {"name": "root is black", "method": "GET", "path": "/api/tree", "status": 200, "expect": [{"path": "root.key", "equals": 17}, {"path": "root.color", "equals": "black"}]}
  ]
}
