{
  "order": 1,
  "title": {"en": "Red-black tree", "ru": "Красно-чёрное дерево"},
  "tagline": {"en": "A balanced binary search tree behind a small JSON API: insert, delete, search.", "ru": "Сбалансированное дерево поиска за маленьким JSON API: вставка, удаление, поиск."},
  "time_limit_s": 600,
  "token_budget": 400000,
  "checks": [
    {"name": "seed: 40 keys, valid red-black tree", "method": "GET", "path": "/api/tree", "status": 200, "expect": [{"path": "size", "equals": 40}, {"path": "root", "rbtree": true}]},
    {"name": "in-order keys", "method": "GET", "path": "/api/tree/keys", "status": 200, "expect": [{"path": "", "equals": [6, 21, 29, 80, 81, 83, 124, 142, 192, 218, 236, 260, 274, 278, 300, 302, 324, 331, 348, 358, 395, 413, 451, 463, 482, 553, 559, 568, 570, 604, 659, 734, 741, 744, 866, 869, 939, 976, 977, 988]}]},
    {"name": "search finds a key", "method": "GET", "path": "/api/tree/search?key=482", "status": 200, "expect": [{"path": "key", "equals": 482}]},
    {"name": "search misses → 404", "method": "GET", "path": "/api/tree/search?key=4242", "status": 404},
    {"name": "insert skips duplicates", "method": "POST", "path": "/api/tree/insert", "body": {"keys": [604, 1000, 1001]}, "status": 200, "expect": [{"path": "inserted", "equals": 2}, {"path": "size", "equals": 42}]},
