{
  "order": 2,
  "title": {"en": "Doubly linked list", "ru": "Двусвязный список"},
  "tagline": {"en": "Nodes with prev and next behind a small JSON API: push, pop, insert, delete, reverse.", "ru": "Узлы с prev и next за маленьким JSON API: push, pop, вставка, удаление, разворот."},
  "time_limit_s": 600,
  "token_budget": 400000,
  "checks": [
    {"name": "seed, head to tail", "method": "GET", "path": "/api/list", "status": 200, "expect": [{"path": "size", "equals": 12}, {"path": "items", "equals": ["apple", "banana", "cherry", "date", "elderberry", "fig", "grape", "honeydew", "kiwi", "lemon", "mango", "nectarine"]}]},
    {"name": "seed, tail to head", "method": "GET", "path": "/api/list/backward", "status": 200, "expect": [{"path": "items", "equals": ["nectarine", "mango", "lemon", "kiwi", "honeydew", "grape", "fig", "elderberry", "date", "cherry", "banana", "apple"]}]},
    {"name": "push-front", "method": "POST", "path": "/api/list/push-front", "body": {"value": "alpha"}, "status_in": [200, 201], "expect": [{"path": "size", "equals": 13}]},
    {"name": "push-back", "method": "POST", "path": "/api/list/push-back", "body": {"value": "omega"}, "status_in": [200, 201], "expect": [{"path": "size", "equals": 14}]},
    {"name": "insert at index 3", "method": "POST", "path": "/api/list/insert", "body": {"index": 3, "value": "middle"}, "status_in": [200, 201], "expect": [{"path": "size", "equals": 15}]},
    {"name": "insert past the end → 400", "method": "POST", "path": "/api/list/insert", "body": {"index": 99, "value": "x"}, "status": 400},
    {"name": "insert keeps both directions", "method": "GET", "path": "/api/list/backward", "status": 200, "expect": [{"path": "items", "equals": ["omega", "nectarine", "mango", "lemon", "kiwi", "honeydew", "grape", "fig", "elderberry", "date", "cherry", "middle", "banana", "apple", "alpha"]}]},
    {"name": "delete index 0", "method": "DELETE", "path": "/api/list/items/0", "status": 200, "expect": [{"path": "value", "equals": "alpha"}]},
    {"name": "delete index 5", "method": "DELETE", "path": "/api/list/items/5", "status": 200, "expect": [{"path": "value", "equals": "elderberry"}]},
    {"name": "delete out of range → 404", "method": "DELETE", "path": "/api/list/items/99", "status": 404},
    {"name": "pop-back", "method": "POST", "path": "/api/list/pop-back", "status": 200, "expect": [{"path": "value", "equals": "omega"}]},
    {"name": "pop-front", "method": "POST", "path": "/api/list/pop-front", "status": 200, "expect": [{"path": "value", "equals": "apple"}]},
    {"name": "reverse", "method": "POST", "path": "/api/list/reverse", "status": 200, "expect": [{"path": "items", "equals": ["nectarine", "mango", "lemon", "kiwi", "honeydew", "grape", "fig", "date", "cherry", "middle", "banana"]}]},
    {"name": "reversed, head to tail", "method": "GET", "path": "/api/list", "status": 200, "expect": [{"path": "size", "equals": 11}, {"path": "items", "equals": ["nectarine", "mango", "lemon", "kiwi", "honeydew", "grape", "fig", "date", "cherry", "middle", "banana"]}]},
    {"name": "reversed, tail to head", "method": "GET", "path": "/api/list/backward", "status": 200, "expect": [{"path": "items", "equals": ["banana", "middle", "cherry", "date", "fig", "grape", "honeydew", "kiwi", "lemon", "mango", "nectarine"]}]},
    {"name": "non-string value → 400", "method": "POST", "path": "/api/list/push-back", "body": {"value": 42}, "status": 400},
    {"name": "clear", "method": "POST", "path": "/api/list/clear", "status": 200, "expect": [{"path": "size", "equals": 0}]},
    {"name": "pop-front on empty → 409", "method": "POST", "path": "/api/list/pop-front", "status": 409},
    {"name": "pop-back on empty → 409", "method": "POST", "path": "/api/list/pop-back", "status": 409},
    {"name": "push-back on empty", "method": "POST", "path": "/api/list/push-back", "body": {"value": "solo"}, "status_in": [200, 201], "expect": [{"path": "size", "equals": 1}]},
    {"name": "one item, both ways", "method": "GET", "path": "/api/list/backward", "status": 200, "expect": [{"path": "items", "equals": ["solo"]}]}
  ]
}
